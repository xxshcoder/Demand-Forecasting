# Copy to .env before starting the stack. NEVER commit .env.

# --- Postgres (one server, three databases: mlflow, airflow, app) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mlflow

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=/mlartifacts
# Provenance tag attached to MLflow runs: "synthetic" or "kaggle".
DATASET_LABEL=synthetic
# Inside Compose containers use http://mlflow:5000; the host uses localhost.
# The API image sets this through the compose file automatically.

# --- Application database (prediction logs) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/app

# --- Airflow (Compose override values; no secrets in production) ---
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@postgres:5432/airflow
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-for-anything-but-local-demo

# --- Serving ---
# Token for POST /admin/reload. Leave empty to disable the endpoint.
ADMIN_TOKEN=change-me
# Overrides params.yaml serving.model_refresh_seconds when set.
MODEL_REFRESH_SECONDS=60
